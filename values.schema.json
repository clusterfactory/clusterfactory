{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["gitea-actions", "jenkins", "both"],
      "description": "Deployment mode: gitea-actions (Gitea + Actions), jenkins (Gitea + Jenkins), or both (hybrid)"
    },
    "wire": {
      "type": "object",
      "properties": {
        "org": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 63,
          "description": "Organization name - lowercase alphanumeric and hyphens only"
        },
        "repo": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
              "minLength": 1,
              "maxLength": 63,
              "description": "Repository name - lowercase alphanumeric and hyphens only"
            }
          },
          "required": ["name"]
        }
      },
      "required": ["org", "repo"]
    },
    "images": {
      "type": "object",
      "properties": {
        "gitea": {
          "$ref": "#/definitions/imageSpec"
        },
        "jenkins": {
          "$ref": "#/definitions/imageSpec"
        },
        "actRunner": {
          "$ref": "#/definitions/imageSpec"
        }
      }
    },
    "gitea": {
      "type": "object",
      "properties": {
        "gitea": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-_]*[a-zA-Z0-9])?$",
                  "minLength": 1,
                  "maxLength": 39,
                  "description": "Gitea admin username"
                },
                "password": {
                  "type": "string",
                  "description": "Gitea admin password - required at install time, leave empty in values.yaml"
                }
              },
              "required": ["username", "password"]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "imageSpec": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Image repository"
        },
        "tag": {
          "type": "string",
          "description": "Image tag"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "description": "Optional SHA256 digest for immutable image pinning (format: sha256:...)"
        }
      },
      "required": ["repository", "tag"]
    }
  }
}
