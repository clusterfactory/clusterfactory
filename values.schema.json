{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mode", "giteaAdmin"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["gitea-actions", "jenkins", "both"],
      "description": "Deployment mode — selects which workflow engine(s) get installed and wired."
    },
    "giteaAdmin": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "password": {
          "type": "string",
          "minLength": 8,
          "description": "Gitea admin password. Must be set explicitly — no default."
        }
      }
    },
    "wire": {
      "type": "object",
      "properties": {
        "org": { "type": "string", "minLength": 1 },
        "repo": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" }
          }
        },
        "jenkinsJob": { "type": "string", "minLength": 1 }
      }
    }
  }
}
