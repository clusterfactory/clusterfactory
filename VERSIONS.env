# VERSIONS.env — single source of truth for all component versions
#
# Sourced by:
#   bootstrap.sh          (online + airgap modes)
#   hack/bundle.sh        (airgap bundle builder)
#   install-platform.yaml (via Gitea org secrets set by bootstrap.sh)
#
# To upgrade a component: change the version here, run hack/bundle.sh,
# commit both VERSIONS.env and the new airgap tarball in the release.

# ── Kubernetes tooling ────────────────────────────────────────────────────────
KUBECTL_VERSION="v1.32.3"
HELM_VERSION="v3.17.1"

# ── Bootstrap-phase charts (installed by bootstrap.sh) ───────────────────────
CERTMANAGER_CHART_VERSION="1.17.1"
GITEA_CHART_VERSION="12.5.0"
CLUSTERFACTORY_CHART_VERSION="0.2.21"

# ── Platform-phase charts (installed by install-platform.yaml) ───────────────
ARGOCD_CHART_VERSION="7.8.28"
HARBOR_CHART_VERSION="1.16.2"
OPENBAO_CHART_VERSION="0.5.0"
CROSSPLANE_CHART_VERSION="1.18.5"
AUTHENTIK_CHART_VERSION="2026.2.1"

# ── Container images (used by act_runner + cockpit + headlamp) ────────────────
ACT_RUNNER_IMAGE="gitea/act_runner"
ACT_RUNNER_TAG="0.2.11"

# ── Helm chart repo URLs (overridden in airgap mode to point at local Harbor) ─
REPO_JETSTACK="https://charts.jetstack.io"
REPO_GITEA="https://dl.gitea.com/charts/"
REPO_CLUSTERFACTORY="https://clusterfactory.github.io/clusterfactory"
REPO_ARGO="https://argoproj.github.io/argo-helm"
REPO_HARBOR="https://helm.goharbor.io"
REPO_OPENBAO="https://openbao.github.io/openbao-helm"
REPO_CROSSPLANE="https://charts.crossplane.io/stable"
REPO_AUTHENTIK="https://charts.goauthentik.io"
