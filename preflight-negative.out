kind: ZarfPackageConfig
metadata:
  name: clusterfactory-preflight
  description: The forge's contract checks (PREREQUISITES.md) as a standalone package.
  version: 0.4.0
  architecture: amd64
  aggregateChecksum: 8779b7de769b30dca1f6c7c4268388419a7277437d34a11e3e4b0a23c0031143
build:
  architecture: amd64
  timestamp: Sun, 20 Sep 2026 05:29:27 +0300
  version: v0.75.0
  migrations:
  - scripts-to-actions
  - pluralize-set-variable
  flavor: upstream
  signed: false
  provenanceFiles:
  - checksums.txt
components:
- name: preflight
  description: Verify the cluster meets the forge's contract (PREREQUISITES.md); fails fast otherwise.
  required: true
  only:
    flavor: upstream
  files:
  - source: ../preflight/preflight.sh
    target: cf-preflight/preflight.sh
    executable: true
  images:
  - docker.io/library/busybox:1.37.0@sha256:7a3ebe5bfd1a4a19797d20b0c0bb39d44393e9a03fd852c0865b0f540d868df0
  actions:
    onDeploy:
      after:
      - maxTotalSeconds: 900
        cmd: ZARF=./zarf PREFLIGHT_STRICT="${ZARF_VAR_PREFLIGHT_STRICT}" PREFLIGHT_IMAGE="${ZARF_CONST_PREFLIGHT_IMAGE}" ./cf-preflight/preflight.sh
        description: Run the preflight checks (see PREREQUISITES.md; results in cf-system/cf-preflight-result)
      onSuccess:
      - mute: true
        cmd: rm -rf cf-preflight
      onFailure:
      - cmd: ./zarf tools kubectl get ns -o name | grep '^namespace/cf-preflight-' | xargs -r ./zarf tools kubectl delete --wait=false || true
        description: Remove any throwaway preflight namespace
constants:
- name: PREFLIGHT_IMAGE
  value: docker.io/library/busybox:1.37.0@sha256:7a3ebe5bfd1a4a19797d20b0c0bb39d44393e9a03fd852c0865b0f540d868df0
variables:
- name: PREFLIGHT_STRICT  currently set to 'true' (default)
  description: Set to "false" to downgrade advisory preflight checks (resources) to warnings; contract checks are never bypassable.
  default: "true"
